        <description lang="en">Lets the eXistenZ skin pick what its home screen rows and sidebar entries show or open: library lists, add-on folders (directly or through Widget Bridge), sources, Kodi screens, or a path typed in by hand.</description>
        <platform>all</platform>
        <license>GPL-3.0</license>
        <source>https://adamsbuilds.github.io/repo/</source>
    </extension>
</addon>
<addon id="skin.existenz" version="0.2.4" name="eXistenZ" provider-name="adamsbuilds">
    <requires>
        <import addon="xbmc.gui" version="5.17.0"/>
        <import addon="script.existenz.helper" version="0.2.3"/>
    </requires>
    <extension point="xbmc.gui.skin" debugging="false" effectslowdown="1.0">
        <res width="1920" height="1080" aspect="16:9" default="true" folder="16x9" />
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en">Netflix-style skin for Kodi (customizable home rows, sidebar and top bar)</summary>
        <description lang="en">A Netflix-style skin built for Android TV boxes and other low-powered devices. Up to eight home pages, each with up to eight rows from any add-on, library list or folder; a customizable sidebar and top bar; a Netflix-like player and OSD; watched and progress bars on the artwork; and a Widget Behavior setting (Normal or Safe) for add-ons that crash when several of their rows load at once.</description>
        <platform>all</platform>
        <license>GPL-3.0-only AND CC-BY-SA-4.0</license>
        <source>https://adamsbuilds.github.io/repo/</source>
        <assets>
            <icon>resources/icon.png</icon>
            <fanart>resources/fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="plugin.video.widgetbridge" name="Widget Bridge" version="1.0.4" provider-name="adamsbuilds">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <reuselanguageinvoker>false</reuselanguageinvoker>
        <summary lang="en">Load any add-on's lists as widgets in their own Python instance</summary>
        <description lang="en">Browse any installed add-on through Widget Bridge and use the folder you end on as a widget / home row. The add-on's own code runs, but in a fresh Python instance for every widget, so add-ons that use reuselanguageinvoker keep that speed-up for browsing while their widgets load side by side without fighting over the one reused instance.</description>
        <platform>all</platform>
        <license>GPL-3.0</license>
        <assets>
            <icon>resources/icon.png</icon>
        </assets>
    </extension>
</addon>
